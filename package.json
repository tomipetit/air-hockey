{
  "name": "air-hockey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/to-artifact.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4"
  }
}
