{
  "name": "air-hockey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,sig -c magenta,cyan \"vite --host\" \"tsx watch server/main.ts\"",
    "dev:https": "concurrently -k -n web,sig -c magenta,cyan \"vite --host --mode https\" \"tsx watch server/main.ts\"",
    "dev:web": "vite --host",
    "dev:server": "tsx watch server/main.ts",
    "build": "npm run typecheck && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/to-artifact.mjs",
    "start": "tsx server/main.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node e2e/two-player.cjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "three": "0.180.0",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "concurrently": "10.0.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
